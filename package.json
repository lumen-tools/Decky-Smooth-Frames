{
  "name": "decky-afmf",
  "version": "1.0.0",
  "description": "Driver-style frame generation (afmf-linux) for the Steam Deck, with per-game toggle and live status",
  "type": "module",
  "scripts": {
    "build": "rollup -c",
    "watch": "rollup -c -w",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "decky",
    "plugin",
    "steam-deck",
    "frame-generation",
    "afmf"
  ],
  "license": "BSD-3-Clause",
  "devDependencies": {
    "@decky/rollup": "^1.0.2",
    "@decky/ui": "^4.11.0",
    "@types/react": "19.1.1",
    "@types/react-dom": "19.1.1",
    "@types/webpack": "^5.28.5",
    "rollup": "^4.53.3",
    "typescript": "^5.6.2"
  },
  "dependencies": {
    "@decky/api": "^1.1.3",
    "react-icons": "^5.3.0",
    "tslib": "^2.7.0"
  },
  "pnpm": {
    "peerDependencyRules": {
      "ignoreMissing": [
        "react",
        "react-dom"
      ]
    }
  },
  "author": "lumen-tools",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lumen-tools/Decky-AFMF.git"
  },
  "bugs": {
    "url": "https://github.com/lumen-tools/Decky-AFMF/issues"
  },
  "homepage": "https://github.com/lumen-tools/Decky-AFMF#readme"
}

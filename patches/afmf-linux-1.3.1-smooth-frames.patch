 #include "swapchain_internal.h"
 
+#include <fcntl.h>
+#include <stdatomic.h>
+#include <unistd.h>
+
+/* Decky Smooth Frames: live control. The plugin writes "<generate 0|1> <max base fps>" into
+ * AFMF_CONTROL_FILE; the present hook re-reads it at most every 250 ms, so turning generation off
+ * and on (an A/B comparison) and changing the base limit need no restart. Generation off works
+ * through the governor: the frames still enter the history, no companion is made and the real
+ * frame is not held, so "off" is the game's own cadence and "on" resumes with a valid history. */
+static atomic_int s_live_generate = 1;
+static atomic_int s_live_max_base_fps = -1; /* -1: the file has not set it, AFMF_MAX_BASE_FPS applies */
+static atomic_llong s_live_next_poll_ns = 0;
+
+void afmf_live_poll(int64_t now_ns)
+{
+    const char *path = afmf_config_get()->control_file;
+    if (path == NULL)
+        return;
+    long long due = atomic_load_explicit(&s_live_next_poll_ns, memory_order_relaxed);
+    if (now_ns < due ||
+        !atomic_compare_exchange_strong(&s_live_next_poll_ns, &due, (long long)now_ns + 250000000LL))
+        return;
+    int fd = open(path, O_RDONLY | O_CLOEXEC);
+    if (fd < 0)
+        return;
+    char buf[64];
+    ssize_t n = read(fd, buf, sizeof buf - 1);
+    (void)close(fd);
+    if (n <= 0)
+        return;
+    buf[n] = '\0';
+    char *end = NULL;
+    long generate = strtol(buf, &end, 10);
+    if (end == buf || (generate != 0 && generate != 1))
+        return;
+    char *rest = end;
+    long fps = strtol(rest, &end, 10);
+    if (end == rest || fps < 0 || fps > 1000)
+        fps = -1;
+    int was = atomic_exchange(&s_live_generate, (int)generate);
+    int old_fps = atomic_exchange(&s_live_max_base_fps, (int)fps);
+    if (was != (int)generate || old_fps != (int)fps)
+        AFMF_INFO("live control: generation %s, base frame rate limit %ld fps", generate ? "on" : "off",
+                  fps >= 0 ? fps : (long)afmf_config_get()->max_base_fps);
+}
+
+bool afmf_live_generate(void)
+{
+    return atomic_load_explicit(&s_live_generate, memory_order_relaxed) != 0;
+}
+
+uint32_t afmf_live_max_base_fps(void)
+{
+    int fps = atomic_load_explicit(&s_live_max_base_fps, memory_order_relaxed);
+    return fps >= 0 ? (uint32_t)fps : afmf_config_get()->max_base_fps;
+}

From 9a6c14c7f59d21cd3ad53451cc5aeb6ada411713 Mon Sep 17 00:00:00 2001
From: Decky-AFMF <decky-afmf@localhost>
Date: Thu, 26 Nov 2026 14:50:26 +0100
Subject: [PATCH] Add AFMF_MAX_BASE_FPS: base frame rate limiter in the present
 hook

---
 src/config.c             |  6 +++++
 src/config.h             |  1 +
 src/swapchain.c          | 49 ++++++++++++++++++++++++++++++++++++++--
 src/swapchain_internal.h |  5 ++++
 4 files changed, 59 insertions(+), 2 deletions(-)

diff --git a/src/config.c b/src/config.c
index 696f9fe..83670cd 100644
--- a/src/config.c
+++ b/src/config.c
@@ -102,6 +102,10 @@ static void init(void)
      * frame rate doubling is not worth its latency. */
     long governor = 1;
     long min_fps = 30;
+    /* Decky-AFMF: a frame rate limiter for the real frames, the counterpart of Radeon Chill next to
+     * AFMF. On a fixed-refresh display half the refresh rate fills every refresh with a real or a
+     * generated frame. Off unless set. */
+    long max_base_fps = 0;
     /* Sum of absolute 8-bit luma differences over a block's 64 pixels between the two frames at
      * rest; 128 is two levels per pixel on average, what temporal anti-aliasing leaves on a
      * still image. Under it the block is stored as static and its search is skipped. */
@@ -146,6 +150,7 @@ static void init(void)
     ok = read_choice("AFMF_PRESENT_MODE", present_modes, 2, &present_mode) && ok;
     ok = read_bounded("AFMF_GOVERNOR", 0, 1, &governor) && ok;
     ok = read_bounded("AFMF_MIN_FPS", 0, 240, &min_fps) && ok;
+    ok = read_bounded("AFMF_MAX_BASE_FPS", 0, 1000, &max_base_fps) && ok;
     ok = read_bounded("AFMF_STATIC_BLOCK_SAD", 0, 16320, &static_block_sad) && ok;
     ok = read_bounded("AFMF_DIRECT_OUTPUT", 0, 1, &direct_output) && ok;
     ok = read_bounded("AFMF_HUD_DETECT", 0, 1, &hud_detect) && ok;
@@ -170,6 +175,7 @@ static void init(void)
     g_config.present_mode = (enum afmf_present_mode)present_mode;
     g_config.governor = governor != 0;
     g_config.min_fps = (uint32_t)min_fps;
+    g_config.max_base_fps = (uint32_t)max_base_fps;
     g_config.static_block_sad = (uint32_t)static_block_sad;
     g_config.direct_output = direct_output != 0;
     g_config.hud_detect = hud_detect != 0;
diff --git a/src/config.h b/src/config.h
index 0e6f30c..3c12704 100644
--- a/src/config.h
+++ b/src/config.h
@@ -46,6 +46,7 @@ struct afmf_config {
     bool direct_ingest;          /* AFMF_DIRECT_INGEST: sample the game's frame straight into the ring and luma (SAMPLED usage) */
     bool sad_int16;              /* AFMF_SAD_INT16=0: the block search's scalar SAD even where shaderInt16 is available */
     uint32_t min_fps;            /* AFMF_MIN_FPS: no companions below this real frame rate (0 = always) */
+    uint32_t max_base_fps;       /* AFMF_MAX_BASE_FPS (Decky-AFMF): the game's real frames are capped at this rate (0 = off) */
     bool invalid;                /* some variable was set but unparsable; caller reports it */
 };
 
diff --git a/src/swapchain.c b/src/swapchain.c
index a387d01..0bffe7c 100644
--- a/src/swapchain.c
+++ b/src/swapchain.c
@@ -175,6 +175,47 @@ VkResult afmf_sc_present_generated(struct afmf_device *dev, struct afmf_swapchai
     return res;
 }
 
+static int64_t monotonic_ns(void)
+{
+    struct timespec ts;
+    (void)clock_gettime(CLOCK_MONOTONIC, &ts);
+    return (int64_t)ts.tv_sec * 1000000000LL + ts.tv_nsec;
+}
+
+/* Decky-AFMF: caps the application's real frames at AFMF_MAX_BASE_FPS. Runs after the present has
+ * been handed on, on the application's thread, so the wait delays the start of its next frame:
+ * input is read after the wait rather than a stale frame being held back. The deadlines advance by
+ * a fixed interval, so a slightly late frame is made up by the next one and the average is exact;
+ * a frame later than a whole interval (loading, a hitch) restarts the schedule instead of letting
+ * a burst of frames catch up. */
+static void limit_base_rate(struct afmf_swapchain *sc)
+{
+    uint32_t fps = afmf_config_get()->max_base_fps;
+    if (fps == 0)
+        return;
+    const int64_t interval = 1000000000LL / (int64_t)fps;
+    int64_t now = monotonic_ns();
+    if (!sc->limit_armed) {
+        sc->limit_armed = true;
+        sc->limit_next_ns = now + interval;
+        AFMF_INFO("swapchain %p: base frame rate limited to %u fps", (void *)sc->handle, fps);
+        return;
+    }
+    if (now > sc->limit_next_ns + interval) {
+        sc->limit_next_ns = now + interval;
+        return;
+    }
+    if (now < sc->limit_next_ns) {
+        struct timespec until = {
+            .tv_sec = (time_t)(sc->limit_next_ns / 1000000000LL),
+            .tv_nsec = (long)(sc->limit_next_ns % 1000000000LL),
+        };
+        while (clock_nanosleep(CLOCK_MONOTONIC, TIMER_ABSTIME, &until, NULL) == EINTR) {
+        }
+    }
+    sc->limit_next_ns += interval;
+}
+
 VkResult afmf_swapchain_present(struct afmf_device *dev, VkQueue queue, const VkPresentInfoKHR *info)
 {
     pthread_mutex_lock(&dev->lock);
@@ -194,7 +235,11 @@ VkResult afmf_swapchain_present(struct afmf_device *dev, VkQueue queue, const Vk
 
     uint64_t ordinal = afmf_sc_update_cadence(dev, sc);
     uint32_t family;
+    VkResult res;
     if (!sc->gen_enabled || !afmf_device_queue_family(dev, queue, &family))
-        return afmf_device_queue_present(dev, queue, info);
-    return afmf_sc_present_generated(dev, sc, queue, family, info, ordinal);
+        res = afmf_device_queue_present(dev, queue, info);
+    else
+        res = afmf_sc_present_generated(dev, sc, queue, family, info, ordinal);
+    limit_base_rate(sc);
+    return res;
 }
diff --git a/src/swapchain_internal.h b/src/swapchain_internal.h
index 9f76d80..d1678c7 100644
--- a/src/swapchain_internal.h
+++ b/src/swapchain_internal.h
@@ -152,6 +152,11 @@ struct afmf_swapchain {
     bool under_floor; /* the real frame rate is below AFMF_MIN_FPS: no companions until it clears it by a margin */
     uint64_t reduced_frames; /* presents that went out without a companion because of the step */
     double frame_ms_ema; /* smoothed time between the application's presents, for pacing */
+    /* Decky-AFMF base frame rate limiter: when the application's next present is due
+     * (CLOCK_MONOTONIC, ns). Touched only in the present hook, which Vulkan serialises per
+     * swapchain. */
+    int64_t limit_next_ns;
+    bool limit_armed;
 
     /* Presentation thread. Under Proton each vkQueuePresentKHR measured 170-400 us of host time
      * on the application's thread; both presents (and the spare refill) run here instead, and
